# Copy to .env locally; configure server values in Amvera environment settings.
BOT_TOKEN=
DB_PATH=database/database.db
# Closed registration; comma-separated positive Telegram user IDs.
ALLOWED_TELEGRAM_IDS=
# Optional export. Must equal the owner recorded in migration v1.
# Empty disables Google Sheets for everyone.
GOOGLE_SHEETS_OWNER_TELEGRAM_ID=
# Supply GOOGLE_CREDENTIALS_B64 securely, or use a key file in credentials/.

# Explicit opt-in: true allows registration in private chats without the allowlist.
OPEN_REGISTRATION=false
